	<generalDataType id="country.dataType">
		<state code="Botswana"/>
		<state code="Eswatini"/>
		<state code="Mozambique"/>
		<state code="Namibia"/>
		<state code="SouthAfrica"/>
	</generalDataType>
	<attributePatterns id="country.pattern" attribute="country">
		<taxa idref="taxa"/>
		<generalDataType idref="country.dataType"/>
	</attributePatterns>

	<empiricalTreeDistributionModel id="treeModel" fileName="ba4_SA_gtr_strict_exp_CT.trees">
		<taxa idref="taxa"/>
	</empiricalTreeDistributionModel>
	<statistic id="treeModel.currentTree" name="Current Tree">
		<empiricalTreeDistributionModel idref="treeModel"/>
	</statistic>

	<strictClockBranchRates id="country.branchRates">
		<rate>
			<parameter id="country.clock.rate" value="0.01" lower="0.0"/>
		</rate>
	</strictClockBranchRates>

	<generalSubstitutionModel id="country.model">
		<generalDataType idref="country.dataType"/>
		<frequencies>
			<frequencyModel id="country.frequencyModel" normalize="true">
				<generalDataType idref="country.dataType"/>
				<frequencies>
					<parameter id="country.frequencies" dimension="5"/>
				</frequencies>
			</frequencyModel>
		</frequencies>
		<rates>
			<parameter id="country.rates" dimension="20" value="1.0"/>
		</rates>
		<rateIndicator>
			<parameter id="country.indicators" dimension="20" value="1.0"/>
		</rateIndicator>
	</generalSubstitutionModel>
	<sumStatistic id="country.nonZeroRates" elementwise="true">
		<parameter idref="country.indicators"/>
	</sumStatistic>
	<siteModel id="country.siteModel">
		<substitutionModel>
			<generalSubstitutionModel idref="country.model"/>
		</substitutionModel>
	</siteModel>

	<frequencyModel id="country.root.frequencyModel" normalize="true">
		<generalDataType idref="country.dataType"/>
		<frequencies>
			<parameter id="country.root.frequencies" dimension="5"/>
		</frequencies>
	</frequencyModel>

	<markovJumpsTreeLikelihood id="country.treeLikelihood" stateTagName="country.states">
		<attributePatterns idref="country.pattern"/>
		<treeModel idref="treeModel"/>
		<siteModel idref="country.siteModel"/>
		<generalSubstitutionModel idref="country.model"/>
		<strictClockBranchRates idref="country.branchRates"/>
		<frequencyModel idref="country.root.frequencyModel"/>
	</markovJumpsTreeLikelihood>

	<prior id="prior">
		<distributionLikelihood>
			<distribution>
				<exponentialDistributionModel>
					<mean>
						<parameter id="country.clock.rate.exp.mean" value="1"/>
					</mean>
				</exponentialDistributionModel>
			</distribution>
			<data>
				<parameter idref="country.clock.rate"/>
			</data>
		</distributionLikelihood>
		<gammaPrior shape="0.5" scale="2" offset="0.0">
			<parameter idref="country.clock.rate.exp.mean"/>
		</gammaPrior>
		<poissonPrior mean="10" offset="0">
			<statistic idref="country.nonZeroRates"/>
		</poissonPrior>
		<uniformPrior lower="0.0" upper="1.0">
			<parameter idref="country.root.frequencies"/>
		</uniformPrior>
		<cachedPrior>
			<gammaPrior shape="1.0" scale="1.0" offset="0.0">
				<parameter idref="country.rates"/>
			</gammaPrior>
			<parameter idref="country.rates"/>
		</cachedPrior>
		<generalSubstitutionModel idref="country.model"/>
	</prior>

	<operators id="operators" optimizationSchedule="log">
		<empiricalTreeDistributionOperator weight="30" metropolisHastings="true">
			<empiricalTreeDistributionModel idref="treeModel"/>
		</empiricalTreeDistributionOperator>
		<scaleOperator scaleFactor="0.75" weight="8">
			<parameter idref="country.clock.rate"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="4">
			<parameter idref="country.clock.rate.exp.mean"/>
		</scaleOperator>
		<scaleOperator scaleFactor="0.75" weight="10" scaleAllIndependently="true">
			<parameter idref="country.rates"/>
		</scaleOperator>
		<bitFlipOperator weight="30">
			<parameter idref="country.indicators"/>
		</bitFlipOperator>
		<deltaExchange delta="0.01" weight="1">
			<parameter idref="country.root.frequencies"/>
		</deltaExchange>
	</operators>

	<mcmc id="mcmc" chainLength="50000000" autoOptimize="true">
		<posterior id="posterior">
		<prior idref="prior"/>
			<likelihood id="likelihood">
				<markovJumpsTreeLikelihood idref="country.treeLikelihood"/>
			</likelihood>
		</posterior>
		<operators idref="operators"/>

		<log id="screenLog" logEvery="10000">
			<posterior idref="posterior"/>
			<prior idref="prior"/>
			<likelihood idref="likelihood"/>
			<parameter idref="country.clock.rate"/>
			<sumStatistic idref="country.nonZeroRates"/>
		</log>

		<log id="fileLog" logEvery="10000" fileName="ba4_SA_gtr_strict_exp_CT_country_posterior_run2.log" overwrite="false">
			<posterior idref="posterior"/>
			<prior idref="prior"/>
			<likelihood idref="likelihood"/>
			<parameter idref="country.root.frequencies"/>
			<parameter idref="country.clock.rate.exp.mean"/>
			<parameter idref="country.clock.rate"/>
			<parameter idref="country.rates"/>
			<parameter idref="country.indicators"/>
			<sumStatistic idref="country.nonZeroRates"/>
			<statistic idref="treeModel.currentTree"/>
			<markovJumpsTreeLikelihood idref="country.treeLikelihood"/>
		</log>

		<logTree id="treeFileLog" logEvery="10000" nexusFormat="true" fileName="ba4_SA_gtr_strict_exp_CT_country_posterior_run2.trees" sortTranslationTable="true">
			<treeModel idref="treeModel"/>
			<posterior idref="posterior"/>
			<trait name="country.states" tag="country">
				<ancestralTreeLikelihood idref="country.treeLikelihood"/>
			</trait>
		</logTree>
	</mcmc>


	<report>
		<property name="timer">
			<mcmc idref="mcmc"/>
		</property>
	</report>
